{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitcoin-hashrate-benchmark",
  "main": "leaderboard-api/worker.mjs",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./ChromebookHashrateBenchmark",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bitcoin-hashrate-leaderboard",
      "database_id": "a2edcc03-4669-4241-9c14-e8ce8bc61d6f",
      "migrations_dir": "leaderboard-api/migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMISSION_LIMITER",
      "namespace_id": "861734219",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
